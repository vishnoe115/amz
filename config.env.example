BOT_TOKEN=
API_ID=
API_HASH=
ADMINS=123456789
BOT_USERNAME=

# PostgreSQL connection URL. Amazon login credentials/session are backed up
# here and restored automatically when a new container starts.
DATABASE_URL=postgresql://user:password@host:5432/database

# Two-letter Amazon storefront country: US, GB, DE, JP, etc.
AMZ_COUNTRY=US

# Maximum time allowed for one download task.
DOWNLOAD_TIMEOUT=7200
